# Unity specific folders to ignore
ORIF/Temp/
ORIF/Library/
ORIF/obj/
ORIF/Logs/

# Cache and build artifacts
ORIF/Library/ShaderCache/
ORIF/Library/BurstCache/
ORIF/Library/Bee/
ORIF/Library/Artifacts/
ORIF/Library/PackageCache/

# Debug and temporary files
ORIF/obj/Debug/
ORIF/ORIF_BurstDebugInformation_DoNotShip


# Node.js specific
Website/scenario_creator/node_modules/
Website/scenario_creator/npm-debug.log
Website/scenario_creator/yarn-error.log
Website/scenario_creator/.env

# Logs
Website/scenario_creator/logs
Website/scenario_creator/*.log

# Runtime data
Website/scenario_creator/pids
Website/scenario_creator/*.pid
Website/scenario_creator/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
Website/scenario_creator/lib-cov

# Coverage directory used by tools like istanbul
Website/scenario_creator/coverage/

# nyc test coverage
Website/scenario_creator/.nyc_output/

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
Website/scenario_creator/.grunt

# Bower dependency directory (https://bower.io/)
Website/scenario_creator/bower_components

# Editor directories and files
Website/scenario_creator/.idea/
Website/scenario_creator/.vscode/
Website/scenario_creator/*.sublime-project
Website/scenario_creator/*.sublime-workspace

# Optional npm cache directory
Website/scenario_creator/.npm

# Optional eslint cache
Website/scenario_creator/.eslintcache

# Optional REPL history
Website/scenario_creator/.node_repl_history

# dotenv environment variables file
Website/scenario_creator/.env

# Mac system files
Website/scenario_creator/.DS_Store

# Build directories
Website/scenario_creator/build/
Website/scenario_creator/dist/

*.apk
APK/

ORIF/.vs/